Meta.DisplayName=Urban Terror 4.3 (TeamKit)
Meta.Description=Serveur dedie officiel d'Urban Terror 4.3 (FPS tactique gratuit de FrozenSand, moteur ioquake3). Installe et mis a jour par l'updater officiel de FrozenSand (environ 1,4 Go, 35 cartes). Modes CTF, Team Survivor, Bomb, Freeze Tag, Gun Game, Jump et les autres ; rotation des cartes, annonce sur la liste publique du jeu, mot de passe RCON. Un seul port, 27960 en UDP. Joueurs visibles dans AMP, console d'AMP branchee sur le serveur (status, kick, map, say...).
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-UrbanTerror
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/FrozenSand/ioq3-for-UrbanTerror-4/master/misc/freedesktop/urbanterror.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=urbanterrorconfig.json
Meta.MetaConfigManifest=urbanterrormetaconfig.json
Meta.ConfigRoot=urbanterror.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=L'updater officiel de FrozenSand lit les reponses du site avec xmllint : le paquet libxml2-utils est installe dans le conteneur par ExtraContainerPackages.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["libxml2-utils"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=1dcacb04-e596-49ca-b0f4-24a4ef7d7c60
Meta.ImportableExtensions=[]
